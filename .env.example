# ==============================================================================
# REAL-TIME PAYMENT FRAUD DETECTION & RISK ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=fraud_engine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/fraud_engine

# Online State Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_DAYS=30

# Message Broker (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_FEATURES=feature-enrichment-group
KAFKA_CONSUMER_GROUP_INFERENCE=ml-inference-group
KAFKA_CONSUMER_GROUP_DECISIONS=risk-decision-group
KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_FEATURES=transactions.features
KAFKA_TOPIC_PREDICTIONS=transactions.predictions
KAFKA_TOPIC_DECISIONS=transactions.decisions
KAFKA_TOPIC_FEEDBACK=transactions.feedback
KAFKA_TOPIC_DLQ=transactions.dlq

# Backend API (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_WORKERS=2

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ML Model & Inference
MODEL_REGISTRY_PATH=./ml/models/saved
ACTIVE_MODEL_NAME=xgboost_fraud_detector
ACTIVE_MODEL_VERSION=v1.0.0
ACTIVE_ANOMALY_MODEL_NAME=isolation_forest_detector
ACTIVE_ANOMALY_MODEL_VERSION=v1.0.0
CALIBRATION_METHOD=isotonic
SHAP_BACKGROUND_SAMPLE_SIZE=100

# Risk Engine Thresholds (0 - 100 Scale)
RISK_THRESHOLD_APPROVE=30.0
RISK_THRESHOLD_BLOCK=75.0

# Risk Engine Signal Weights (Sum = 1.0)
WEIGHT_CALIBRATED_ML=0.55
WEIGHT_ANOMALY_SCORE=0.15
WEIGHT_BEHAVIORAL_SCORE=0.15
WEIGHT_RULE_SIGNALS=0.15

# Transaction Generator (Simulation)
GENERATOR_RATE_TPS=5.0
GENERATOR_ANOMALY_PROBABILITY=0.08
GENERATOR_VELOCITY_ATTACK_PROBABILITY=0.02

# Monitoring & Metrics
PROMETHEUS_METRICS_PORT=9100
METRICS_ENABLED=true
